---
import Default from '@astrojs/starlight/components/Head.astro';
import { LANGS, trackOf } from '../../tracks.mjs';
import heavy from '../../../fonts/lexiereadable-heavy-webfont.woff2?url';
import display from '../../../fonts/lexiereadable-bold-webfont.woff2?url';
import body from '../../../fonts/lexiereadable-regular-webfont.woff2?url';
import mono from '@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url';

// Preloading the Latin faces lets first paint use them, so text does not reflow when fonts swap in.
const fonts = [heavy, display, body, mono];
// Shared pages belong to both search scopes; a language page belongs only to its own.
const track = trackOf(Astro.locals.starlightRoute.id);
const searchLanguages = track ? [track] : Object.keys(LANGS);

// Browsers with Speculation Rules fetch a page once the pointer rests on its link, into a cache meant for navigations;
// the others use Astro's hover prefetch below. Prefetch only: a prerender would run scripts before the click.
// Shared pages' language switches are buttons, not navigations.
const speculation = {
	prefetch: [
		{
			where: { and: [{ href_matches: '/*' }, { not: { selector_matches: '[data-shared] a, a[download]' } }] },
			eagerness: 'moderate',
		},
	],
};
---

<Default />
{searchLanguages.map((lang) => <meta data-pagefind-filter="code-language[content]" content={lang} />)}
<script type="speculationrules" is:inline set:html={JSON.stringify(speculation)} />
<script>
	// Keep Chromium's navigation cache; use the HTTP cache in Firefox and Safari. Astro supplies hover/focus
	// debounce, URL deduplication, and the offline/data-saver checks. Its automatic all-link prefetch is off.
	if (!HTMLScriptElement.supports?.('speculationrules')) {
		const enable = (link: HTMLAnchorElement) => {
			if (link.hasAttribute('data-astro-prefetch') || link.hasAttribute('download') ||
				link.closest('[data-shared]') || (link.target && link.target !== '_self')) return;
			const url = new URL(link.href);
			if (url.origin !== location.origin ||
				(url.pathname === location.pathname && url.search === location.search)) return;
			link.dataset.astroPrefetch = 'hover';
		};
		const scan = (node: ParentNode) => node.querySelectorAll<HTMLAnchorElement>('a[href]').forEach(enable);
		scan(document);
		// Search results are inserted after page load. Astro also observes new links and attaches its listeners.
		new MutationObserver((mutations) => {
			for (const mutation of mutations) for (const node of mutation.addedNodes) {
				if (!(node instanceof Element)) continue;
				if (node instanceof HTMLAnchorElement && node.hasAttribute('href')) enable(node);
				scan(node);
			}
		}).observe(document.body, { childList: true, subtree: true });
	}
</script>
<!-- Language pages set the language and remember it; shared pages use the remembered one (C# by default).
     Runs before first paint so language-specific blocks never flash. -->
<script is:inline>
	(() => {
		const root = document.documentElement;
		const apply = () => {
			const track = location.pathname.match(/^\/(csharp|gdscript)(\/|$)/)?.[1];
			let lang = track;
			try {
				if (track) localStorage.setItem('tweens-lang', track);
				else lang = localStorage.getItem('tweens-lang');
			} catch {}
			root.dataset.lang = lang === 'csharp' ? 'csharp' : 'gdscript';
		};
		apply();

		// Arriving from the twin page's language switch (LangSwitch.astro): the switch paints on the previous
		// language, then slides over. The content and sidebar restore the reader's place from window.__twCarry.
		try {
			const carry = JSON.parse(sessionStorage.getItem('tweens-lang-carry') || 'null');
			sessionStorage.removeItem('tweens-lang-carry');
			if (carry?.to === location.pathname && Date.now() - carry.at < 15000) {
				window.__twCarry = carry;
				if (carry.from !== root.dataset.lang) root.dataset.langFrom = carry.from;
			}
		} catch {}
		if (root.dataset.langFrom)
			addEventListener('DOMContentLoaded', () =>
				requestAnimationFrame(() => requestAnimationFrame(() => delete root.dataset.langFrom)),
			);

		// A page restored by Back or Forward keeps its old state; bring it up to date with the current choice.
		addEventListener('pageshow', (event) => {
			if (!event.persisted) return;
			apply();
			delete root.dataset.langFrom;
			document.dispatchEvent(new CustomEvent('tweens:lang'));
		});
	})();
</script>
{fonts.map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />)}
