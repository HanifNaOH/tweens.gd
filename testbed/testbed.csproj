<Project Sdk="Godot.NET.Sdk/4.7.2">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <EnableDynamicLoading>true</EnableDynamicLoading>
        <IsTrimmable>true</IsTrimmable>
        <IsPackable>false</IsPackable>
        <VerifyReferenceTrimCompatibility>true</VerifyReferenceTrimCompatibility>
        <!-- TwoDogWebBoot.cs takes a function pointer to the source-generated plugins initializer. -->
        <DefineConstants>$(DefineConstants);LIBGODOT_ENABLED;TWODOG_WEB_BOOT</DefineConstants>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <!-- Keep the nested hosts out of the default globs; their .gdignore hides them from the Godot editor. -->
        <DefaultItemExcludes>$(DefaultItemExcludes);testbed.2dog/**;testbed.tests/**;testbed.web/**</DefaultItemExcludes>
    </PropertyGroup>
    <ItemGroup>
        <!-- C# uses the library project; the staged addon serves GDScript mode only. -->
        <Compile Remove="addons/tweens_gd/csharp/**/*.cs" />
        <ProjectReference Include="../csharp/tweens.gd.csproj" />
        <PackageReference Include="2dog.godotsharp" Version="$(TwoDogVersion)" />
        <PackageReference Include="2dog.godotsharp.editor" Version="$(TwoDogVersion)" Condition="'$(Configuration)' == 'Debug' Or '$(Configuration)' == 'Editor'" />
        <!-- The web bootstrap compiles into this assembly: scripts resolve from the one that holds the
             source-generated plugins initializer. -->
        <Compile Include="testbed.web/TwoDogWebBoot.cs" />
        <!-- The source viewer shows these exact files, including in trimmed and web exports. -->
        <EmbeddedResource Include="Gallery/**/*.cs" LogicalName="GallerySource/%(RecursiveDir)%(Filename)%(Extension)" />
        <EmbeddedResource Include="Gallery/**/*.gd" LogicalName="GallerySource/%(RecursiveDir)%(Filename)%(Extension)" />
        <Content Include="Fonts/OFL.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
        <Content Include="Fonts/BricolageGrotesque-OFL.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
    <Target Name="StageGDScriptAddon" BeforeTargets="BeforeBuild">
        <ItemGroup>
            <GalleryAddon Include="../addons/tweens_gd/**/*" />
            <!-- Mirror the addon, including its committed .uid files: files removed from the source must not linger. -->
            <StagedGalleryAddon Include="addons/tweens_gd/**/*" Exclude="addons/tweens_gd/**/~*" />
            <StaleGalleryAddon Include="@(StagedGalleryAddon)" Exclude="@(GalleryAddon->'addons/tweens_gd/%(RecursiveDir)%(Filename)%(Extension)')" />
        </ItemGroup>
        <Delete Files="@(StaleGalleryAddon)" />
        <Copy SourceFiles="@(GalleryAddon)" DestinationFiles="@(GalleryAddon->'addons/tweens_gd/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    </Target>
</Project>
